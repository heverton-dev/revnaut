# RevNault Dental Ops - Environment Template
URL="http://localhost:8000"
USER_EMAIL="admin@revnault.local"
USER_PASSWORD="change_me"

# GitHub & Deploy (AIDD Framework)
GITHUB_USER=""
DEFAULT_ROOT_DOMAIN="localhost"

# Cluster & Database Configuration
DATABASE_URL="sqlite+aiosqlite:////app/data/revnault.db"
POSTGRES_URL="postgresql+asyncpg://revnault_admin:change_me@postgres:5432/revnault"
REDIS_URL="redis://redis:6379/0"

# Cloudflare R2 / S3 Storage & WAL Backup
R2_ENDPOINT_URL="https://<account_id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="placeholder_access_key"
R2_SECRET_ACCESS_KEY="placeholder_secret_key"
R2_BUCKET_NAME="revnaut-wal-backups"

# Services Secret Keys
JWT_SECRET_KEY="placeholder_jwt_secret"
SUPERSET_SECRET_KEY="placeholder_superset_secret"
LIVEKIT_API_KEY="placeholder_livekit_key"
LIVEKIT_API_SECRET="placeholder_livekit_secret"

# Sessão: validade do token de login em segundos (padrão 12h)
SESSION_TTL_SECONDS="43200"
# Inteligência de Mercado: agendador do lote noturno do radar (1 = ligado)
MARKET_INTEL_SCHEDULER_ENABLED="1"
# Opcional: LLM local para classificação (sem ele, usa o classificador determinístico)
OLLAMA_BASE_URL=""
OLLAMA_MODEL="qwen2.5:7b"

# Segredos obrigatórios em produção (REVNAULT_ENV=production): mínimo 32 caracteres, gere com secrets.token_urlsafe(48)
SESSION_SECRET_KEY=""
VAULT_SECRET_KEY=""
# Webhooks inbound (fail-closed): cadastre o mesmo valor no painel de cada provedor
OMNICHANNEL_WEBHOOK_SECRET=""
DOCUMENSO_WEBHOOK_SECRET=""
CALCOM_WEBHOOK_SECRET=""
LISTMONK_WEBHOOK_SECRET=""
# Origens autorizadas (CORS com credenciais)
CORS_ALLOWED_ORIGINS="https://revnault.vpsconexao.org"
# Link de recuperação de senha enviado por e-mail
APP_PUBLIC_URL="https://revnault.vpsconexao.org"
