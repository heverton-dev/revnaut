# Redesign conexao.com.br - variáveis de deploy (sem segredos)
# Copie para .env e ajuste. Carregado automaticamente por `docker compose`.
COMPOSE_PROJECT_NAME=site-redesign
SITE_HOST=site-redesign.vpsconexao.org
IMAGE_NAME=conexao/site-redesign
IMAGE_TAG=latest
TRAEFIK_NETWORK=network_conexao
TRAEFIK_CERTRESOLVER=letsencryptresolver
CONTAINER_PORT=8080
# yes = bloqueia indexação (homologação). Use no em produção definitiva.
NOINDEX=yes
